region              = "eu-west-2"
project             = "voicemail"
environment         = "production"
service_name        = "service"
hostzone            = "iposg.com"
cpu                 = 256
memory              = 512
enable_auto_scaling = true
max_capacity        = 1
min_capacity        = 1
desired_count       = 1
deployment_mode     = "FARGATE" # FARGATE or EC2
host_header         = "voicemail.iposg.com" # ALB Value
subdomain_name      = "voicemail" # Route53 Value
#nginx_image_tag  = "voicemail-production-service:nginx-fa3423c"
#phpapp_image_tag = "voicemail-production-service:php-fa3423c"
database_secrets    = "iposg-database-secrets"
common_secrets      = "common-secret-keys"
